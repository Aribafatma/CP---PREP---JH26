#include <bits/stdc++.h>
using namespace std;

// DFS function to traverse the component
void dfs(int node, const vector<vector<int>>& adj, vector<bool>& visited) {
    visited[node] = true;
    for (int neighbor : adj[node]) {
        if (!visited[neighbor]) {
            dfs(neighbor, adj, visited);
        }
    }
}

int main() {
    // Fast I/O
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n, m;
    if (!(cin >> n >> m)) return 0;

    // Adjacency list for graph (1-indexed)
    vector<vector<int>> adj(n + 1);
    for (int i = 0; i < m; ++i) {
        int u, v;
        cin >> u >> v;
        adj[u].push_back(v);
        adj[v].push_back(u); // Since the graph is undirected
    }

    int a, b;
    cin >> a >> b;

    // Track visited nodes
    vector<bool> visited(n + 1, false);

    // Run DFS starting from node A
    dfs(a, adj, visited);

    // If node B is marked as visited, they are in the same component
    if (visited[b]) {
        cout << "YES\n";
    } else {
        cout << "NO\n";
    }

    return 0;
}
