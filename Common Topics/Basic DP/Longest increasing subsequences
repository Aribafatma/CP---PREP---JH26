#include <bits/stdc++.h>
using namespace std;

int main() {
    // Optimize standard I/O operations for speed
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n;
    if (!(cin >> n)) return 0;

    vector<int> a(n);
    for (int i = 0; i < n; i++) {
        cin >> a[i];
    }

    // tails[i] stores the smallest tail of all increasing subsequences of length i+1 found so far
    vector<int> tails;

    for (int x : a) {
        // Find the first element greater than or equal to x
        auto it = lower_bound(tails.begin(), tails.end(), x);
        
        if (it == tails.end()) {
            // x extends the largest subsequence
            tails.push_back(x);
        } else {
            // Replace the existing element with a smaller tail value x
            *it = x;
        }
    }

    // The size of the tails vector is the length of the longest increasing subsequence
    cout << tails.size() << "\n";

    return 0;
}
