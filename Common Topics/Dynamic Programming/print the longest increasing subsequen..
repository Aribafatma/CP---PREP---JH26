#include <bits/stdc++.h>
using namespace std;

int main() {
    // Optimizing input/output operations
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n;
    if (!(cin >> n)) return 0;

    vector<long long> a(n);
    for (int i = 0; i < n; ++i) {
        cin >> a[i];
    }

    // dp[i] stores the length of LIS ending at index i
    vector<int> dp(n, 1);
    // parent[i] tracks the index of the previous element in the LIS sequence
    vector<int> parent(n, -1);

    int max_len = 1;
    int best_end_idx = 0;

    // Compute DP transitions
    for (int i = 0; i < n; ++i) {
        for (int j = 0; j < i; ++j) {
            if (a[j] < a[i] && dp[j] + 1 > dp[i]) {
                dp[i] = dp[j] + 1;
                parent[i] = j;
            }
        }
        if (dp[i] > max_len) {
            max_len = dp[i];
            best_end_idx = i;
        }
    }

    // Backtrack to reconstruct the sequence
    vector<long long> lis;
    int curr = best_end_idx;
    while (curr != -1) {
        lis.push_back(a[curr]);
        curr = parent[curr];
    }

    // Reverse to output in correct relative order
    reverse(lis.begin(), lis.end());

    // Print the results
    cout << max_len << "\n";
    for (int i = 0; i < max_len; ++i) {
        cout << lis[i] << (i == max_len - 1 ? "" : " ");
    }
    cout << "\n";

    return 0;
}
